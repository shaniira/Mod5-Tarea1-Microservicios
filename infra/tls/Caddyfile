# Proxy TLS local (fase 7, hallazgo S6): termina HTTPS delante del frontend y del gateway.
# Certificados de una CA local de Caddy ("tls internal"): el navegador avisa hasta que se confía en
# ella (docker compose cp tls-proxy:/data/caddy/pki/authorities/local/root.crt .). En producción TLS
# lo termina el Ingress de Kubernetes (k8s/40-ingress.yaml) con un certificado real.
{
	# Sin panel de administración ni redirección automática en el puerto 80.
	admin off
	auto_https disable_redirects
}

(seguridad) {
	tls internal
	header Strict-Transport-Security "max-age=31536000"
}

# Frontend (SPA)
https://localhost:8443 {
	import seguridad
	reverse_proxy frontend:8080
}

# API: el gateway
https://localhost:8444 {
	import seguridad
	reverse_proxy gateway:8080
}
