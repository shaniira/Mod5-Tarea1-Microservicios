{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andinaseguros.example/contracts/events/policy.cancelled.v1.schema.json",
  "title": "policy.cancelled.v1",
  "description": "Una poliza paso a CANCELADA. Contrato definido en la fase 6 para claims-service (policy_ref). Hoy ninguna operacion del sistema cancela polizas (ni el monolito ni policy-service), asi que todavia no hay productor. Exchange: andina.events. Publica: policy-service. Consume: claims-service.",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "aggregateId", "aggregateVersion", "producer", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "enum": ["PolicyCancelled"] },
    "eventVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "aggregateVersion": { "type": "integer", "minimum": 2 },
    "correlationId": { "type": ["string", "null"] },
    "producer": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["policyId"],
      "properties": {
        "policyId": { "type": "string", "format": "uuid" },
        "customerId": { "type": ["string", "null"], "format": "uuid" },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
