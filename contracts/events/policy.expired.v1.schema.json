{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backendseguros.example/contracts/events/policy.expired.v1.schema.json",
  "title": "policy.expired.v1",
  "description": "Una poliza paso a VENCIDA. Contrato definido en la fase 6 para claims-service (policy_ref). Hoy ninguna operacion del sistema vence polizas (ni el monolito ni policy-service), asi que todavia no hay productor; el mismo sobre sirve para policy.cancelled.v1 (eventType PolicyCancelled). Exchange: andina.events. Publica: policy-service. Consume: claims-service.",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "aggregateId", "aggregateVersion", "producer", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "enum": ["PolicyExpired"] },
    "eventVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "aggregateVersion": { "type": "integer", "minimum": 2 },
    "correlationId": { "type": ["string", "null"] },
    "producer": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["policyId"],
      "properties": {
        "policyId": { "type": "string", "format": "uuid" },
        "customerId": { "type": ["string", "null"], "format": "uuid" },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
