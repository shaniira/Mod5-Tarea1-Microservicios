{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andinaseguros.example/contracts/events/policy.issued.v1.schema.json",
  "title": "policy.issued.v1",
  "description": "Se emitio una poliza. Lo publica policy-service en andina.events (el exchange heredado andina.insurance.events, donde publicaba el monolito, se retiro en el paso 6.11). Consumen: notification-service, claims-service (policy_ref) y quotation-service (marca la cotizacion EMITIDA). La cola de auditoria se elimino en el paso 7.9.",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "aggregateId", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "PolicyIssued" },
    "eventVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": "string", "format": "uuid", "description": "Igual a data.policyId" },
    "aggregateVersion": { "type": ["integer", "null"], "description": "null cuando lo publica el backend; 1 cuando lo publica policy-service (la version de la poliza sube en cada cambio de estado)" },
    "correlationId": { "type": ["string", "null"], "description": "Agregado en la fase 1 (opcional)" },
    "producer": { "type": ["string", "null"], "description": "Agregado en la fase 1 (opcional)" },
    "data": {
      "type": "object",
      "required": ["policyId", "quoteId", "customerId", "policyNumber"],
      "properties": {
        "policyId": { "type": "string", "format": "uuid" },
        "quoteId": { "type": "string", "format": "uuid" },
        "customerId": { "type": "string", "format": "uuid" },
        "policyNumber": { "type": "string" },
        "vehicleId": { "type": ["string", "null"], "format": "uuid", "description": "Opcional (fase 6)" },
        "premium": { "type": ["number", "null"], "description": "Opcional (fase 6)" },
        "currency": { "type": ["string", "null"], "description": "Opcional (fase 6)" },
        "startDate": { "type": ["string", "null"], "format": "date", "description": "Opcional (fase 6): inicio de vigencia" },
        "endDate": { "type": ["string", "null"], "format": "date", "description": "Opcional (fase 6): fin de vigencia" },
        "status": { "type": ["string", "null"], "description": "Opcional (fase 6): estado de la poliza al emitirse (VIGENTE)" }
      }
    }
  }
}
