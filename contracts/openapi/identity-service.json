{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "API Gateway"
    }
  ],
  "paths": {
    "/api/mfa/configurar": {
      "post": {
        "tags": [
          "mfa-controller"
        ],
        "operationId": "configurar",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MfaSetupResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/mfa/activar": {
      "post": {
        "tags": [
          "mfa-controller"
        ],
        "operationId": "activar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearUsuarioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/mfa/verificar": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "verificarMfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "sesion-controller"
        ],
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoLogin"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "google",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/facebook/session": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "facebookSession",
        "parameters": [
          {
            "name": "ticket",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/usuarios/{username}/estado": {
      "patch": {
        "tags": [
          "sesion-controller"
        ],
        "operationId": "cambiarEstado",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EstadoUsuarioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/mfa/estado": {
      "get": {
        "tags": [
          "mfa-controller"
        ],
        "operationId": "estado",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MfaStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PerfilResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/facebook": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "facebook",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "desvincularFacebook",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/facebook/callback": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "facebookCallback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "jwks-controller"
        ],
        "operationId": "jwks",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mfa": {
      "delete": {
        "tags": [
          "mfa-controller"
        ],
        "operationId": "desactivar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MfaSetupResponse": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string"
          },
          "otpauthUri": {
            "type": "string"
          },
          "qrCodeDataUri": {
            "type": "string"
          }
        }
      },
      "MfaCodeRequest": {
        "required": [
          "codigo"
        ],
        "type": "object",
        "properties": {
          "codigo": {
            "pattern": "^[0-9]{6}$",
            "type": "string"
          }
        }
      },
      "CrearUsuarioRequest": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "rol": {
            "type": "string",
            "enum": [
              "ADMIN",
              "ACTUARIO",
              "AGENTE",
              "CLIENTE"
            ]
          }
        }
      },
      "MfaVerifyRequest": {
        "required": [
          "challengeToken",
          "codigo"
        ],
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string"
          },
          "codigo": {
            "pattern": "^[0-9]{6}$",
            "type": "string"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "expiraEnSegundos": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ResultadoLogin": {
        "type": "object",
        "properties": {
          "requiresMfa": {
            "type": "boolean"
          },
          "token": {
            "$ref": "#/components/schemas/TokenResponse"
          },
          "challengeToken": {
            "type": "string"
          },
          "challengeExpiresIn": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GoogleLoginRequest": {
        "required": [
          "idToken"
        ],
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string"
          }
        }
      },
      "EstadoUsuarioRequest": {
        "required": [
          "activo"
        ],
        "type": "object",
        "properties": {
          "activo": {
            "type": "boolean"
          }
        }
      },
      "MfaStatusResponse": {
        "type": "object",
        "properties": {
          "habilitado": {
            "type": "boolean"
          }
        }
      },
      "PerfilResponse": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "rol": {
            "type": "string"
          },
          "nombres": {
            "type": "string"
          },
          "apellidos": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      }
    }
  }
}
