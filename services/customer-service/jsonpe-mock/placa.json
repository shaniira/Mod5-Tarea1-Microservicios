{
  "request": {
    "method": "POST",
    "urlPath": "/api/placa"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "success": true,
      "message": "Placa simulada (jsonpe-mock)",
      "data": {
        "placa": "{{jsonPath request.body '$.placa'}}",
        "marca": "TOYOTA",
        "modelo": "YARIS",
        "serie": "SIM",
        "color": "GRIS",
        "motor": "SIM-1",
        "vin": "SIMULADO{{jsonPath request.body '$.placa'}}"
      }
    }
  }
}
