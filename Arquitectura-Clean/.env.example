# Copiar este archivo como .env y completar los valores vacios.
# No subir el archivo .env con credenciales al repositorio.

# Google: usar el mismo identificador que VITE_GOOGLE_CLIENT_ID en frontend/.env.
GOOGLE_CLIENT_ID=

# Facebook: completar desde el panel de la app en Meta for Developers.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Nombre informativo; el backend no consume esta variable.
FACEBOOK_APP_NAME=

# Direcciones para las pruebas locales. Desde la fase 0, el frontend y Facebook llegan al
# backend a traves del gateway (:8080), no directo (:8083). Si se usa un FACEBOOK_APP_ID real,
# esta misma URL debe estar registrada como "Valid OAuth Redirect URI" en Meta for Developers.
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/auth/facebook/callback
FACEBOOK_SCOPES=public_profile
FACEBOOK_FRONTEND_CALLBACK_URL=http://localhost:5173/login
FACEBOOK_LOGIN_TICKET_TTL_SECONDS=60

# Clave propia de la aplicacion: 32 bytes aleatorios codificados en Base64.
# No es el App Secret de Facebook. Conservarla para los tokens ya cifrados.
FACEBOOK_TOKEN_ENCRYPTION_KEY=

# JSON.pe: token de la API de consulta de placas y de la API de WhatsApp.
# Antes estaban escritos en application.yml (riesgo S3); ahora se leen de aqui.
# Los tokens que ya estaban en el repositorio se consideran expuestos: rotarlos en el panel
# de JSON.pe antes de usarlos en un entorno real.
JSONPE_TOKEN=
WHATSAPP_TOKEN=
